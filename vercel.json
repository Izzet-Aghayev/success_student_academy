{
  "framework": null,
  "buildCommand": "python manage.py collectstatic --noinput",
  "outputDirectory": "staticfiles",
  "devCommand": "python manage.py runserver 0.0.0.0:$PORT",
  "cleanUrls": false,
  "trailingSlash": false,
  "functions": {
    "config/wsgi.py": {
      "runtime": "@vercel/python@latest",
      "memory": 1024,
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/static/(.*)",
      "destination": "/$1"
    },
    {
      "source": "/((?!static/).*)",
      "destination": "/config/wsgi.py"
    }
  ],
  "headers": [
    {
      "source": "/static/(.*\\.(?:css|js))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=604800, must-revalidate"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/static/(.*\\.(?:woff2?|ttf|eot|otf|png|jpe?g|gif|svg|webp|ico|avif))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, s-maxage=31536000, immutable"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
